# ---------------------------------------------------------------------------
# Zugriffsschutz fuer die Loesungsblaetter
#
# WICHTIG: AuthUserFile braucht den ABSOLUTEN Pfad der Datei .htpasswd auf dem
# Server, nicht den Pfad in diesem Ordner. Der Pfad unten ist ein Platzhalter
# und muss angepasst werden, sonst liefert Apache einen 500er.
# Den richtigen Pfad zeigt beim Provider meist die Dateiverwaltung; oft ist es
# etwas wie  /var/www/vhosts/<domain>/httpdocs/.htpasswd  oder
# /home/<benutzer>/public_html/.htpasswd
#
# Zum Testen genuegt es, die Loesungsdatei im Browser aufzurufen: es muss ein
# Anmeldefenster erscheinen (Benutzer: lehrer).
# ---------------------------------------------------------------------------

<Files "arbeitsblatt-feldstaerke-loesung.docx">
    AuthType Basic
    AuthName "Loesungen - nur fuer Lehrkraefte"
    AuthUserFile /ABSOLUTER/PFAD/ZUM/ORDNER/.htpasswd
    Require valid-user
</Files>

# Falls spaeter weitere Loesungsblaetter dazukommen, greift diese Regel fuer
# alle Dateien, deren Name auf "-loesung" endet. Dann kann der Block oben weg.
#<FilesMatch "-loesung\.(docx|pdf)$">
#    AuthType Basic
#    AuthName "Loesungen - nur fuer Lehrkraefte"
#    AuthUserFile /ABSOLUTER/PFAD/ZUM/ORDNER/.htpasswd
#    Require valid-user
#</FilesMatch>

# Die Passwortdatei selbst darf nie ausgeliefert werden.
# Apache 2.4:
<Files ".htpasswd">
    Require all denied
</Files>

# Apache 2.2 kennt "Require all denied" nicht. Dort stattdessen:
#<Files ".htpasswd">
#    Order allow,deny
#    Deny from all
#</Files>
